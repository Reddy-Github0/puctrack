# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=puctrack

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the URL your React dev server runs on
CLIENT_ORIGIN=http://localhost:5173

# Email (optional) - leave blank to run without sending real emails;
# the server will just log what it would have sent to the console.
# For Gmail: use an "App Password" (Google Account > Security > App Passwords),
# not your normal login password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=PUCTrack <no-reply@puctrack.in>
